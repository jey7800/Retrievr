{
 "cache_format": 1,
 "output": {
  "reasoning": "Quarterly-result tables identify releases, supplements, reports, presentations, and call transcripts. Q4 is retained as Q4 even when filenames also say FY. Interim reports cover H1; comparison-period supplements are restated series. English is used for the English documents; the explicitly German interim report is German.",
  "type_rules": [
   {
    "pattern": "transcript.*fixed[ _-]?income|fixed[ _-]?income.*transcript",
    "target": "any",
    "type": "fixed_income_call_transcript"
   },
   {
    "pattern": "fixed[ _-]?income.*(presentation|call)|presentation.*fixed[ _-]?income",
    "target": "any",
    "type": "fixed_income_presentation"
   },
   {
    "pattern": "financial data supplement|\\bfds\\b",
    "target": "any",
    "type": "financial_data_supplement"
   },
   {
    "pattern": "interim[ _-]?report",
    "target": "url",
    "type": "half_year_report"
   },
   {
    "pattern": "earnings[ _-]?report",
    "target": "url",
    "type": "quarterly_report"
   },
   {
    "pattern": "analyst.*transcript|transcript.*analyst|transcript.*conference call|prepared remarks",
    "target": "any",
    "type": "analyst_call_transcript"
   },
   {
    "pattern": "media[ _-]?release",
    "target": "any",
    "type": "press_release"
   },
   {
    "pattern": "quarterly results.*presentation|analyst conference call.*presentation|presentation.*analyst conference call",
    "target": "any",
    "type": "results_presentation"
   },
   {
    "pattern": "comparison[ _-]?periods",
    "target": "url",
    "type": "quarterly_series_restated"
   }
  ],
  "period_rules": [
   {
    "pattern": "comparison[-_ ]periods[-_ ]20\\d{2}[-_](?P<year>20\\d{2})",
    "target": "url"
   },
   {
    "pattern": "(?P<q>Q[1-4]|[1-4]Q|T[1-4])[-_ ]?(?:FY[-_ ]?)?(?P<year>20\\d{2})",
    "target": "any"
   },
   {
    "pattern": "(?P<year>20\\d{2})[-_ ](?:\\d{2}[-_ ]\\d{2}[-_ ])?(?P<q>Q[1-4]|[1-4]Q|T[1-4])",
    "target": "any"
   },
   {
    "pattern": "(?P<year>20\\d{2})[-_ ](?:H1|S1|1H)",
    "target": "any"
   }
  ],
  "language_rules": [
   {
    "pattern": "-\\s*EN(?:\\b|$)",
    "target": "link_title",
    "language": "en"
   },
   {
    "pattern": "-\\s*DE(?:\\b|$)",
    "target": "link_title",
    "language": "de"
   }
  ],
